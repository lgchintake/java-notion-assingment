# =========================================
# Java Service (Spring Boot / Gradle)
# =========================================
java-service/build/
java-service/.gradle/
java-service/out/
java-service/bin/
java-service/logs/
java-service/*.log
java-service/HELP.md

# Gradle wrapper jar should be committed; ignore local gradle caches only
java-service/.gradle/**
!java-service/gradle/wrapper/gradle-wrapper.jar
!java-service/gradle/wrapper/gradle-wrapper.properties

# Compiled class files
java-service/**/*.class

# Spring Boot
java-service/application-local.yml
java-service/application-local.properties
java-service/.env

# Java packaging
java-service/*.jar
java-service/*.war
!java-service/gradle/wrapper/*.jar

